@page
@model Tracker.Pages.Issues.CreateModel
@{
    ViewData["Title"] = "Report Issue";
}

<h1>Report New Issue</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Issue.Title" class="form-label"></label>
                <input asp-for="Issue.Title" class="form-control" />
                <span asp-validation-for="Issue.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.Description" class="form-label"></label>
                <textarea asp-for="Issue.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Issue.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.Severity" class="form-label"></label>
                <select asp-for="Issue.Severity" class="form-select" asp-items="Html.GetEnumSelectList<Tracker.Enums.Severity>()">
                    <option value="">-- Select Severity --</option>
                </select>
                <span asp-validation-for="Issue.Severity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.ProjectId" class="form-label">Project</label>
                <select asp-for="Issue.ProjectId" class="form-select" asp-items="Model.ProjectSelectList">
                    <option value="">-- Select Project --</option>
                </select>
                <span asp-validation-for="Issue.ProjectId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.MachineId" class="form-label">Machine (Optional)</label>
                <select asp-for="Issue.MachineId" class="form-select" asp-items="Model.MachineSelectList">
                    <option value="">-- Select Machine --</option>
                </select>
                <span asp-validation-for="Issue.MachineId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.ReportedById" class="form-label">Reported By</label>
                <select asp-for="Issue.ReportedById" class="form-select" asp-items="Model.PeopleSelectList">
                    <option value="">-- Select Person --</option>
                </select>
                <span asp-validation-for="Issue.ReportedById" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Issue.AssignedToId" class="form-label">Assign To (Optional)</label>
                <select asp-for="Issue.AssignedToId" class="form-select" asp-items="Model.PeopleSelectList">
                    <option value="">-- Select Person --</option>
                </select>
                <span asp-validation-for="Issue.AssignedToId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-danger">Report Issue</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#Issue_ProjectId').change(function() {
                var projectId = $(this).val();
                if (projectId) {
                    $.get('/Issues/GetMachinesByProject', { projectId: projectId }, function(data) {
                        var machineSelect = $('#Issue_MachineId');
                        machineSelect.empty();
                        machineSelect.append('<option value="">-- Select Machine --</option>');
                        $.each(data, function(i, machine) {
                            machineSelect.append('<option value="' + machine.value + '">' + machine.text + '</option>');
                        });
                    });
                }
            });
        });
    </script>
}
