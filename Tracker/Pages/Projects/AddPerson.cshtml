@page
@model Tracker.Pages.Projects.AddPersonModel
@{
    ViewData["Title"] = "Add Person to Project";
}

<h1>Add Person to @Model.Project.Name</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" asp-for="ProjectId" />

            <div class="mb-3">
                <label asp-for="PersonId" class="form-label">Select Person</label>
                <select asp-for="PersonId" class="form-select" asp-items="Model.AvailablePeople">
                    <option value="">-- Select Person --</option>
                </select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>

            @if (!Model.AvailablePeople.Any())
            {
                <div class="alert alert-info">
                    All people have been added to this project. <a asp-page="/People/Create">Create a new person</a>
                </div>
            }

            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@(!Model.AvailablePeople.Any())">Add to Project</button>
                <a asp-page="Details" asp-route-id="@Model.ProjectId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
