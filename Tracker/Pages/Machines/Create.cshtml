@page
@model Tracker.Pages.Machines.CreateModel
@{
    ViewData["Title"] = "Add Machine";
}

<h1>Add New Machine</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Machine.SerialNumber" class="form-label"></label>
                <input asp-for="Machine.SerialNumber" class="form-control" />
                <span asp-validation-for="Machine.SerialNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Machine.ProjectId" class="form-label">Project</label>
                <select asp-for="Machine.ProjectId" class="form-select" asp-items="Model.ProjectSelectList">
                    <option value="">-- Select Project --</option>
                </select>
                <span asp-validation-for="Machine.ProjectId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Add Machine</button>
                <a asp-page="/Projects/Details" asp-route-id="@Model.Machine.ProjectId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
