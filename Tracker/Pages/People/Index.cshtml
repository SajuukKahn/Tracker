@page
@model Tracker.Pages.People.IndexModel
@{
    ViewData["Title"] = "People";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>People</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Add Person
    </a>
</div>

@if (!Model.People.Any())
{
    <div class="alert alert-info">
        <h4>No people found</h4>
        <p>Start by adding people to your projects.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Projects</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var person in Model.People)
                {
                    <tr>
                        <td><strong>@person.FirstName @person.LastName</strong></td>
                        <td>@person.Email</td>
                        <td>@Model.PersonProjectCounts.GetValueOrDefault(person.Id, 0)</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@person.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
